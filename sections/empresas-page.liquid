    },
    {
      "type": "image_picker",
      "id": "gallery_image_1",
      "label": "Imagen galería 1 (grande)"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_2",
      "label": "Imagen galería 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_3",
      "label": "Imagen galería 3"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_4",
      "label": "Imagen galería 4"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_5",
