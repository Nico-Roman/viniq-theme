      <ol>
        <li>El descuento de <strong>$3.000</strong> con el código <strong>PRIMERA</strong> ha sido reservado exclusivamente para usted.</li>
        <li>Al abandonar este sitio, <strong>la oferta quedará anulada de forma permanente</strong> y el código expirará inmediatamente.</li>
        <li>No será posible recuperar este beneficio ni reclamarlo en una visita futura.</li>
        <li>El precio de tu cava VINIQ volverá al valor regular de $24.990 sin posibilidad de excepción.</li>
      </ol>
    </div>
    <p style="font-size:13px;color:#888;margin-bottom:18px;">Al hacer clic en "Volver y aprovechar" reconoces que has leído y aceptado los términos anteriores.</p>
    <div class="vq-exit-actions">
      <a href="#" class="vq-btn" onclick="vqAddAndOpen(); return false;">✅ Volver y aprovechar mi descuento</a>
      <button class="vq-btn-secondary" onclick="vqClose('vq-exit')">Renuncio a mi descuento de $3.000 y salgo</button>
    </div>
  </div>
</div>

<script>
(function() {
  var VQ_VARIANT_ID = {{ product.selected_or_first_available_variant.id }};
  var BACKEND_URL = "https://web-production-13291.up.railway.app";
  var sessionId = null;
  var customerName = "";
  var customerPhone = "";

  function addMessage(text, role) {
    var container = document.getElementById("chat-messages");
    var div = document.createElement("div");
    div.className = role === "customer" ? "msg-customer" : "msg-agent";
    div.innerHTML = "<span>" + text + "</span>";
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  }
  function startPolling() {
    setInterval(function() {
      fetch(BACKEND_URL + "/get-responses?session_id=" + sessionId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.responses && data.responses.length > 0) {
            data.responses.forEach(function(r) { addMessage(r, "agent"); });
          }
        }).catch(function(){});
    }, 3000);
  }

  document.getElementById("chat-widget-btn").addEventListener("click", function() {
    var box = document.getElementById("chat-widget-box");
    box.style.display = box.style.display === "block" ? "none" : "block";
  });
  document.getElementById("chat-start").addEventListener("click", function() {
    var name  = document.getElementById("chat-name").value.trim();
    var phone = document.getElementById("chat-phone").value.trim();
    if (!name) { alert("Por favor ingresa tu nombre."); return; }
    customerName  = name;
    customerPhone = phone;
    sessionId = Math.random().toString(36).substring(2, 8).toUpperCase();
    document.getElementById("chat-info").style.display      = "none";
    document.getElementById("chat-messages").style.display   = "block";
    document.getElementById("chat-input-area").style.display = "block";
    addMessage("¡Hola " + name + "! ¿En qué te podemos ayudar?", "agent");
    startPolling();
    fetch(BACKEND_URL + "/send-message", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session_id: sessionId, name: customerName, phone: customerPhone, message: "Chat iniciado" })
    });
  });
  document.getElementById("chat-send").addEventListener("click", function() {
    var message = document.getElementById("chat-message").value.trim();
    if (!message) return;
    addMessage(message, "customer");
    document.getElementById("chat-message").value = "";
    fetch(BACKEND_URL + "/send-message", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ session_id: sessionId, name: customerName, phone: customerPhone, message: message })
    });
  });

  var vqIsLogged  = {{ vq_is_logged | json }};
  var vqPurchased = {{ vq_has_purchased | json }};
  var vqIsProductPage = {{ request.page_type | json }} === 'product' &&
                        {{ product.handle | json }} === 'cava-de-vino-plegable-de-madera-diseno-funcional-y-elegante';
  var vqShouldShow = vqIsProductPage && (!vqIsLogged || (vqIsLogged && !vqPurchased));
  var exitShown = false;

  window.vqClose = function(id) {
    document.getElementById(id).classList.remove('active');
  };
  window.vqCopy = function(btn) {
    navigator.clipboard.writeText('PRIMERA').then(function() {
      btn.textContent = '¡Copiado!';
      btn.style.background = '#7a2c2c';
      btn.style.color = '#fff';
      setTimeout(function() {
        btn.textContent = 'Copiar';
        btn.style.background = '';
        btn.style.color = '';
      }, 2000);
    });
  };
  window.vqAddAndOpen = function() {
    vqClose('vq-discount');
    vqClose('vq-exit');
    fetch('/cart/clear.js', { method: 'POST' })
      .then(function() {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: VQ_VARIANT_ID, quantity: 1 })
        });
      })
      .then(function(res) {
        if (!res.ok) throw new Error('error');
        window.location.href = '/checkout?discount=PRIMERA';
      })
      .catch(function() {
        window.location.href = '/cart/' + VQ_VARIANT_ID + ':1?checkout[discount_code]=PRIMERA&redirect=/checkout';
      });
  };

  function startTimer() {
    var todayKey = 'vq_expiry_' + new Date().toISOString().slice(0, 10);
    Object.keys(localStorage).forEach(function(k) {
      if (k.startsWith('vq_expiry_') && k !== todayKey) localStorage.removeItem(k);
    });
    var expiry = parseInt(localStorage.getItem(todayKey) || '0');
    if (!expiry || expiry < Date.now()) {
      expiry = Date.now() + (24 * 60 * 60 * 1000);
      localStorage.setItem(todayKey, expiry.toString());
    }
    var el = document.getElementById('vq-countdown');
    if (!el) return;
    var iv = setInterval(function() {
      var diff = expiry - Date.now();
      if (diff <= 0) { clearInterval(iv); el.textContent = '00:00:00'; return; }
      var h = Math.floor(diff / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      el.textContent = String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    }, 1000);
  }

  if (vqShouldShow) {
    startTimer();
    setTimeout(function() {
      document.getElementById('vq-discount').classList.add('active');
    }, 7000);
    document.addEventListener('mouseleave', function(e) {
      if (e.clientY <= 5 && !exitShown) {
        exitShown = true;
        document.getElementById('vq-discount').classList.remove('active');
        document.getElementById('vq-exit').classList.add('active');
      }
    });
  }

})();
</script>
