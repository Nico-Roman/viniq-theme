{% assign vq_has_purchased = false %}
{% if customer %}
  {% assign vq_is_logged = true %}
  {% for order in customer.orders limit:50 %}
    {% assign order_month = order.created_at | date: "%Y-%m" %}
    {% assign current_month = "now" | date: "%Y-%m" %}
    {% if order_month == current_month %}
      {% assign vq_has_purchased = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% else %}
  {% assign vq_is_logged = false %}
{% endif %}

<style>
  :root {
    --vq-wine: #7a2c2c;
    --vq-gold: #c9a84c;
    --vq-cream: #fdf6ee;
    --vq-dark: #1a1a1a;
  }
  #chat-widget-btn {
    position: fixed;
    bottom: 88px;
    left: 20px;
    z-index: 9999;
    background: var(--vq-dark);
    color: white;
    border: none;
    border-radius: 50%;
    width: 56px;
    height: 56px;
    font-size: 22px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,0,0,0.28);
    transition: transform 0.2s ease, box-shadow 0.2s;
  }
  #chat-widget-btn:hover { transform: scale(1.08); box-shadow: 0 6px 20px rgba(0,0,0,0.35); }
  #chat-widget-box {
    display: none;
    position: fixed;
    bottom: 156px;
    left: 20px;
    z-index: 9999;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    width: 300px;
    overflow: hidden;
    font-family: inherit;
    border: 1px solid #e8e8e8;
  }
  body:not(.vq-has-sticky) #chat-widget-btn { bottom: 24px; }
  body:not(.vq-has-sticky) #chat-widget-box { bottom: 92px; }
  #chat-header { background: var(--vq-dark); color: white; padding: 14px 18px; font-weight: 700; font-size: 14px; letter-spacing: 0.5px; text-transform: uppercase; }
  #chat-body { padding: 16px; }
  #chat-info input { width: 100%; margin-bottom: 10px; padding: 10px 12px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 13px; box-sizing: border-box; font-family: inherit; color: #111; outline: none; }
  #chat-info input:focus { border-color: #111; }
  #chat-start { width: 100%; background: var(--vq-dark); color: white; border: none; padding: 12px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px; text-transform: uppercase; font-family: inherit; }
  #chat-messages { display: none; height: 200px; overflow-y: auto; border: 1px solid #e0e0e0; border-radius: 8px; padding: 10px; margin-bottom: 10px; font-size: 13px; }
  .msg-customer { text-align: right; margin-bottom: 8px; }
  .msg-customer span { background: #111; color: white; padding: 6px 10px; border-radius: 12px 12px 2px 12px; display: inline-block; max-width: 80%; }
  .msg-agent { text-align: left; margin-bottom: 8px; }
  .msg-agent span { background: #f0f0f0; color: #111; padding: 6px 10px; border-radius: 12px 12px 12px 2px; display: inline-block; max-width: 80%; }
  #chat-input-area { display: none; }
  #chat-input-area textarea { width: 100%; padding: 10px 12px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 13px; box-sizing: border-box; font-family: inherit; resize: none; height: 65px; outline: none; }
  #chat-input-area textarea:focus { border-color: #111; }
  #chat-send { width: 100%; background: #111; color: white; border: none; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; letter-spacing: 0.5px; text-transform: uppercase; font-family: inherit; margin-top: 8px; }
  .vq-overlay { display: none; position: fixed; inset: 0; background: rgba(20,10,5,0.72); backdrop-filter: blur(4px); z-index: 10000; align-items: center; justify-content: center; animation: vqFadeIn 0.35s ease; }
  .vq-overlay.active { display: flex; }
  @keyframes vqFadeIn  { from { opacity: 0 } to { opacity: 1 } }
  @keyframes vqSlideUp { from { opacity: 0; transform: translateY(40px) } to { opacity: 1; transform: translateY(0) } }
  .vq-popup { background: var(--vq-cream); border-radius: 4px; max-width: 460px; width: 92%; padding: 40px 36px 32px; position: relative; animation: vqSlideUp 0.4s cubic-bezier(.22,1,.36,1); text-align: center; box-shadow: 0 32px 80px rgba(0,0,0,0.45); }
  .vq-popup__close { position: absolute; top: 12px; right: 16px; background: none; border: none; font-size: 22px; cursor: pointer; color: #999; line-height: 1; }
  .vq-popup__close:hover { color: var(--vq-dark); }
  .vq-tag { display: inline-block; background: var(--vq-wine); color: #fff; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; padding: 4px 12px; border-radius: 2px; margin-bottom: 16px; }
  .vq-popup h2 { font-family: Georgia, serif; font-size: 28px; color: var(--vq-dark); margin: 0 0 8px; line-height: 1.2; }
  .vq-popup p { font-size: 15px; color: #555; margin: 0 0 20px; line-height: 1.5; }
  .vq-code-box { display: flex; align-items: center; justify-content: center; gap: 10px; background: #fff; border: 2px dashed var(--vq-gold); border-radius: 4px; padding: 14px 18px; margin-bottom: 20px; }
  .vq-code-box span { font-family: 'Courier New', monospace; font-size: 22px; font-weight: bold; color: var(--vq-wine); letter-spacing: 3px; }
  .vq-copy-btn { background: none; border: 1px solid var(--vq-wine); color: var(--vq-wine); font-size: 12px; padding: 4px 10px; border-radius: 3px; cursor: pointer; transition: all .2s; }
  .vq-copy-btn:hover { background: var(--vq-wine); color: #fff; }
  .vq-timer { font-size: 13px; color: #888; margin-bottom: 22px; }
  .vq-timer strong { color: var(--vq-wine); font-size: 15px; font-variant-numeric: tabular-nums; }
  .vq-btn { display: block; width: 100%; padding: 15px; background: var(--vq-wine); color: #fff; font-size: 15px; font-weight: 600; letter-spacing: 0.5px; border: none; border-radius: 3px; cursor: pointer; text-decoration: none; transition: background .2s, transform .1s; }
  .vq-btn:hover { background: #5e2020; transform: translateY(-1px); }
  .vq-dismiss { display: block; margin-top: 14px; font-size: 12px; color: #aaa; cursor: pointer; text-decoration: underline; }
  .vq-dismiss:hover { color: #666; }
  #vq-exit .vq-popup { max-width: 500px; text-align: left; }
  #vq-exit .vq-contract-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid #ddd; }
  #vq-exit .vq-seal { font-size: 36px; line-height: 1; }
  #vq-exit .vq-contract-header h3 { margin: 0 0 2px; font-family: Georgia, serif; font-size: 18px; color: var(--vq-dark); }
  #vq-exit .vq-contract-header p { margin: 0; font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 1px; }
  .vq-clauses { background: #fff; border: 1px solid #e0d8cc; border-radius: 4px; padding: 16px 18px; margin-bottom: 20px; font-size: 13.5px; color: #444; line-height: 1.7; }
  .vq-clauses ol { margin: 0; padding-left: 18px; }
  .vq-clauses li { margin-bottom: 6px; }
  .vq-clauses strong { color: var(--vq-wine); }
  .vq-exit-actions { display: flex; gap: 10px; flex-direction: column; }
  .vq-btn-secondary { display: block; width: 100%; padding: 13px; background: #fff; color: #888; font-size: 13px; border: 1px solid #ddd; border-radius: 3px; cursor: pointer; text-align: center; transition: background .2s; }
  .vq-btn-secondary:hover { background: #f5f0eb; color: #555; }
</style>

