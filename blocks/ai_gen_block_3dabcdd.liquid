{% doc %}
  @prompt
    Un diseño editorial de estilo revista
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-magazine-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
  }

  .ai-magazine-main-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-magazine-main-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-magazine-main-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 500px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-magazine-main-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-main-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-magazine-main-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-magazine-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 12px;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-magazine-main-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.5;
    margin: 0;
    color: {{ block.settings.overlay_text_color }};
    opacity: 0.9;
  }

  .ai-magazine-sidebar-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-card-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-magazine-card-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.card_image_width }}px;
    height: {{ block.settings.card_image_width }}px;
    border-radius: {{ block.settings.card_image_radius }}px;
    overflow: hidden;
  }

  .ai-magazine-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-magazine-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-magazine-card-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-card-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ai-magazine-card-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_category_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
    color: {{ block.settings.card_category_color }};
  }

  .ai-magazine-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.card_text_color }};
  }

  .ai-magazine-card-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_excerpt_size }}px;
    line-height: 1.4;
    margin: 0;
    color: {{ block.settings.card_text_color }};
    opacity: 0.8;
  }

  .ai-magazine-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-magazine-main-placeholder-{{ ai_gen_id }} {
      min-height: 350px;
    }

    .ai-magazine-main-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.main_title_size }}px * 0.7);
    }

    .ai-magazine-card-{{ ai_gen_id }} {
      flex-direction: row;
    }

    .ai-magazine-card-image-wrapper-{{ ai_gen_id }} {
      width: 100px;
      height: 100px;
    }
  }
{% endstyle %}

<magazine-layout-{{ ai_gen_id }}
  class="ai-magazine-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-magazine-container-{{ ai_gen_id }}">
    <div class="ai-magazine-main-{{ ai_gen_id }}">
      {% if block.settings.main_image %}
        <img
          src="{{ block.settings.main_image | image_url: width: 1200 }}"
          alt="{{ block.settings.main_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.main_image.width }}"
          height="{{ block.settings.main_image.height }}"
          class="ai-magazine-main-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-magazine-main-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-magazine-empty-state-{{ ai_gen_id }}">
            Agrega una imagen principal
          </div>
        </div>
      {% endif %}

      <div class="ai-magazine-main-overlay-{{ ai_gen_id }}">
        {% if block.settings.main_category != blank %}
          <div class="ai-magazine-main-category-{{ ai_gen_id }}">{{ block.settings.main_category }}</div>
        {% endif %}
        {% if block.settings.main_title != blank %}
          <h2 class="ai-magazine-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
        {% endif %}
        {% if block.settings.main_excerpt != blank %}
          <p class="ai-magazine-main-excerpt-{{ ai_gen_id }}">{{ block.settings.main_excerpt }}</p>
        {% endif %}
      </div>
    </div>

    <div class="ai-magazine-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'card_' | append: i | append: '_image'
          assign category_key = 'card_' | append: i | append: '_category'
          assign title_key = 'card_' | append: i | append: '_title'
          assign excerpt_key = 'card_' | append: i | append: '_excerpt'

          assign card_image = block.settings[image_key]
          assign card_category = block.settings[category_key]
          assign card_title = block.settings[title_key]
          assign card_excerpt = block.settings[excerpt_key]
        %}

        <div class="ai-magazine-card-{{ ai_gen_id }}">
          <div class="ai-magazine-card-image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 300 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="300"
                height="300"
                class="ai-magazine-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-magazine-card-placeholder-{{ ai_gen_id }}">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-magazine-card-content-{{ ai_gen_id }}">
            {% if card_category != blank %}
              <div class="ai-magazine-card-category-{{ ai_gen_id }}">{{ card_category }}</div>
            {% endif %}
            {% if card_title != blank %}
              <h3 class="ai-magazine-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}
            {% if card_excerpt != blank %}
              <p class="ai-magazine-card-excerpt-{{ ai_gen_id }}">{{ card_excerpt }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</magazine-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class MagazineLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('magazine-layout-{{ ai_gen_id }}', MagazineLayout{{ ai_gen_id }});
  })();
</script>

{% schema %}
